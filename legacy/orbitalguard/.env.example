# =====================================================================
# OrbitalGuard Environment Configuration Template
# =====================================================================

# ---------------------------------------------------------------------
# Supabase & Database Configuration
# ---------------------------------------------------------------------
# Supabase API Credentials
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Database Configuration (PostgreSQL URL or SQLite fallback)
DATABASE_URL=sqlite:///./orbitalguard.db
# For PostgreSQL / Supabase: postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ---------------------------------------------------------------------
# Groq API / LLM Reasoning
# ---------------------------------------------------------------------
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_REASONING_MODEL="llama-3.3-70b-versatile"
GROQ_FAST_MODEL="llama-3.1-8b-instant"

# ---------------------------------------------------------------------
# Tracking & Screening Engine Configuration
# ---------------------------------------------------------------------
SCREENING_THRESHOLD_KM=50.0
COARSE_ALTITUDE_BUFFER_KM=50.0
PROPAGATION_HORIZON_MINUTES=90
PROPAGATION_STEP_MINUTES=1.0

# ---------------------------------------------------------------------
# CelesTrak Ingestion Configuration
# ---------------------------------------------------------------------
CELESTRAK_BASE_URL=https://celestrak.org/NORAD/elements/gp.php
OFFLINE_MODE=false

# ---------------------------------------------------------------------
# App & Service Ports Configuration
# ---------------------------------------------------------------------
ENVIRONMENT="development"
PORT=8000
PROPAGATION_SERVICE_PORT=8000
RISK_SERVICE_PORT=8001
MANEUVER_SERVICE_PORT=8002
OPTIMIZER_SERVICE_PORT=8003
FRONTEND_PORT=3000

