# =====================================================================
# OrbitWatch configuration template — copy to .env (which is gitignored).
# Credentials live only in .env, never in source code (SRS 4.2).
# =====================================================================

# ---- MySQL ------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
# Needed once by `ow setup` / `ow mysql-setup` (and by `ow restore-mysql`).
MYSQL_ROOT_PASSWORD=your-mysql-root-password

# Generated by `ow mysql-setup` — one account per application role:
# MYSQL_AUTH_PASSWORD=  MYSQL_VIEWER_PASSWORD=  MYSQL_ANALYST_PASSWORD=
# MYSQL_ADMIN_PASSWORD=  MYSQL_JOBS_PASSWORD=  MYSQL_BACKUP_PASSWORD=

# ---- MongoDB (local sharded cluster) ------------------------------------
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
# Generated by `ow mongo-init`:
# MONGO_ROOT_PASSWORD=  MONGO_JOBS_PASSWORD=  MONGO_ANALYST_PASSWORD=

# ---- Space-Track.org (free account at space-track.org) ------------------
# Adds the GP catalogue (the debris and rocket bodies CelesTrak's public groups do not
# publish), element-set history (decay reports) and decay messages (re-entry model training).
# SPACETRACK_USER is accepted as the old name of SPACETRACK_USERNAME.
SPACETRACK_USERNAME=
SPACETRACK_PASSWORD=

# ---- E-mail (alert e-mails, password reset) -----------------------------
# Gmail: the address and a 16-character app password (Google Account > Security > App passwords).
SMTP_USERNAME=
SMTP_PASSWORD=
# Only for a provider other than Gmail (defaults: smtp.gmail.com, 587, starttls, MAIL_FROM = SMTP_USERNAME):
# SMTP_HOST=
# SMTP_PORT=
# SMTP_SECURITY=starttls      # starttls | ssl | none
# MAIL_FROM=

# ---- AI decision support (optional: without a key the agent runs deterministically)
GROQ_API_KEY=
GROQ_REASONING_MODEL=openai/gpt-oss-120b

# ---- Web --------------------------------------------------------------
# Generated by `ow mysql-setup`:
# FLASK_SECRET_KEY=
# Links in e-mails always use this address (never the request's Host header):
# APP_BASE_URL=https://localhost:8443
# `ow serve` / `ow service`: HTTPS port and the plain-HTTP port that only redirects to it
# ORBITWATCH_HTTPS_PORT=8443
# ORBITWATCH_HTTP_PORT=8080
# A real certificate instead of the self-signed localhost one:
# ORBITWATCH_TLS_CERT=
# ORBITWATCH_TLS_KEY=
# Speed: seconds the dashboard counts, filter lookups and data coverage are kept (0 = off), idle keep-alive
# connections per listener (0 is fastest on Windows, see orbitwatch/server.py) and worker threads:
# ORBITWATCH_READ_CACHE_S=20
# ORBITWATCH_KEEPALIVE=0
# ORBITWATCH_THREADS=48

# ---- Paths ------------------------------------------------------------
# ORBITWATCH_RUNTIME=C:\Users\<you>\orbitwatch-runtime
# MYSQL_BIN_DIR=C:\Program Files\MySQL\MySQL Server 8.4\bin
# Development: reuse downloaded files instead of re-downloading (1 = on)
# ORBITWATCH_USE_CACHE=0
