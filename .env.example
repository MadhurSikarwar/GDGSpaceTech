# =====================================================================
# OrbitWatch configuration template — copy to .env (which is gitignored).
# Credentials live only in .env, never in source code (SRS 4.2).
# =====================================================================

# ---- MySQL ------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
# Needed once by `ow setup` / `ow mysql-setup` (and by `ow restore-mysql`).
MYSQL_ROOT_PASSWORD=your-mysql-root-password

# Generated by `ow mysql-setup` — one account per application role:
# MYSQL_AUTH_PASSWORD=  MYSQL_VIEWER_PASSWORD=  MYSQL_ANALYST_PASSWORD=
# MYSQL_ADMIN_PASSWORD=  MYSQL_JOBS_PASSWORD=  MYSQL_BACKUP_PASSWORD=

# ---- MongoDB (local sharded cluster) ------------------------------------
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
# Generated by `ow mongo-init`:
# MONGO_ROOT_PASSWORD=  MONGO_JOBS_PASSWORD=  MONGO_ANALYST_PASSWORD=

# ---- Space-Track.org (optional: older history, re-entry training data) --
SPACETRACK_USER=
SPACETRACK_PASSWORD=

# ---- AI decision support (optional: without a key the agent runs deterministically)
GROQ_API_KEY=
GROQ_REASONING_MODEL=openai/gpt-oss-120b

# ---- Web --------------------------------------------------------------
# Generated by `ow mysql-setup`:
# FLASK_SECRET_KEY=

# ---- Paths ------------------------------------------------------------
# ORBITWATCH_RUNTIME=C:\Users\<you>\orbitwatch-runtime
# MYSQL_BIN_DIR=C:\Program Files\MySQL\MySQL Server 8.4\bin
# Development: reuse downloaded files instead of re-downloading (1 = on)
# ORBITWATCH_USE_CACHE=0
